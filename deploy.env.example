# Copy to `deploy.env` (gitignored) and fill in. Read by `deploy.sh` on your machine only --
# nothing here is secret, and nothing here ends up in the bundle except VITE_API_URL.
#
#   cp deploy.env.example deploy.env

# SSH target of the server the frontend runs on. Whatever `ssh <this>` accepts.
DEPLOY_HOST=deploy@server.tvoj-domen.rs

# Directory on the server. Created on the first deploy (needs sudo once).
DEPLOY_PATH=/opt/web

# The frontend's own domain. Must have an A record pointing at the server, and the backend must
# know it as FRONTEND_URL, exactly, without a trailing slash.
APP_DOMAIN=app.tvoj-domen.rs

# Base URL of the API, with the /api path -- src/lib/axios.ts appends endpoints straight onto it.
VITE_API_URL=https://api.tvoj-domen.rs/api

# Where the server clones from, and which ref it deploys. GIT_REPO is only used on the very
# first deploy; after that the clone already has its remote.
GIT_REPO=https://github.com/dev-uros/vue-front-ai-setup.git
GIT_BRANCH=main
